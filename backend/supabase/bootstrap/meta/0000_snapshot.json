          "name": "doubts_class_matches_content",
          "value": "\"doubts\".\"class_id\" IS NULL OR \"doubts\".\"class_id\" = \"doubts\".\"content_id\""
        },
        "doubts_status_valid": {
          "name": "doubts_status_valid",
          "value": "\"doubts\".\"status\" IN ('open', 'answered', 'resolved')"
        },
        "doubts_resolved_matches_status": {
          "name": "doubts_resolved_matches_status",
          "value": "\"doubts\".\"resolved\" = (\"doubts\".\"status\" = 'resolved')"
        },
        "doubts_message_length": {
          "name": "doubts_message_length",
          "value": "length(btrim(\"doubts\".\"message\")) BETWEEN 1 AND 10000"
        },
        "doubts_title_length": {
          "name": "doubts_title_length",
          "value": "length(btrim(\"doubts\".\"title\")) BETWEEN 1 AND 200 AND length(\"doubts\".\"title\") <= 200"
        },
        "doubts_description_length": {
          "name": "doubts_description_length",
          "value": "length(btrim(\"doubts\".\"description\")) BETWEEN 1 AND 10000 AND length(\"doubts\".\"description\") <= 10000"
        }
      },
