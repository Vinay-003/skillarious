    "db:bootstrap": "drizzle-kit generate --config drizzle.bootstrap.config.ts",
    "db:check-empty": "tsx scripts/migrateEmpty.ts check --project-ref=ykllmcwljsfeluhpvzbv",
    "db:apply-empty": "tsx scripts/migrateEmpty.ts apply --project-ref=ykllmcwljsfeluhpvzbv",
    "db:cli-check-empty": "tsx scripts/migrateViaCLI.ts check --project-ref=ykllmcwljsfeluhpvzbv",
