# Copy missing values into backend/.env.local; do not overwrite existing secrets.
# Step-by-step instructions: docs/environment-setup.md (repository root).
# This file is placeholders only. Never put secrets in NEXT_PUBLIC_* variables.

# Supabase Dashboard > Connect > Session pooler (IPv4, port 5432).
# Replace PASSWORD privately; URL-encode reserved password characters.
DATABASE_URL=postgresql://postgres.ykllmcwljsfeluhpvzbv:PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres
# Database > Settings > SSL Configuration > download CA certificate.
# Set a local absolute path if system CA verification fails; never disable TLS.
DATABASE_SSL_CA_FILE=
SUPABASE_URL=https://ykllmcwljsfeluhpvzbv.supabase.co
# Settings > API Keys > Secret keys. Preferred backend-only sb_secret_... key.
SUPABASE_SECRET_KEY=
# Legacy service_role alternative; leave blank when SUPABASE_SECRET_KEY is set.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLIC_BUCKET=public-assets
SUPABASE_PRIVATE_BUCKET=course-content
# Explicit confirmation for the guarded empty-project migration commands only.
CONFIRMED_EMPTY_PROJECT_REF=ykllmcwljsfeluhpvzbv

# Generate two independent random secrets locally (see guide).
JWT_SECRET=
REFRESH_SECRET=
FRONTEND_URL=http://localhost:4002
PORT=4001
TRUST_PROXY=0
# Safe method/route-template/status/timing logs; never passwords, tokens or OTPs.
LOG_REQUESTS=1

# Render Free default: HTTPS Resend. Keep keys in .env.local/Render secrets only.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Resend > Domains: verify your domain, then choose a sender on that domain.
# Optional for local testing; defaults to Resend's no-domain test sender.
RESEND_FROM=Skillarious <onboarding@resend.dev>

# Optional direct SMTP: explicitly EMAIL_PROVIDER=smtp, local or paid-host only.
# Render Free blocks outbound SMTP. Do not set this on Render.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional Render -> Vercel SMTP relay. Set EMAIL_PROVIDER=vercel_smtp after
# deploying the frontend route and storing the matching token on both hosts.
EMAIL_RELAY_URL=
EMAIL_RELAY_TOKEN=

# CURRENT implementation: one merchant, one-time course purchases, USD Sandbox.
# Apps & Credentials > Sandbox > Merchant REST app. Not multiparty commissions.
# Students use PERSONAL Sandbox login; never ask buyers for API keys.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_MODE=sandbox

# APInex account dashboard > API keys. Documented IDs; verify with ai:check.
APINEX_API_KEY=
APINEX_PRIMARY_MODEL=free/deepseek-v4.1-flash
APINEX_FALLBACK_MODEL=free/mimo-v2.6-pro

# Optional demo-only seed; disabled by default. Choose a local password first.
ALLOW_DEMO_SEED=false
DEMO_SEED_PASSWORD=
# No Razorpay, Cloudinary, student API secrets, or teacher API secrets required.
